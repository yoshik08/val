# ---- auth.js (next-auth v5) ----
# generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# canonical url of this web app (used by auth.js for callbacks)
AUTH_URL=http://localhost:3000

# ---- backend api ----
NEXT_PUBLIC_API_URL=http://localhost:10000

# ---- short-lived api jwt (HS256) ----
# must match the API's JWT secret; generate: openssl rand -base64 32
# server-only — never prefixed with NEXT_PUBLIC_
API_JWT_SECRET=

# ---- local dev only ----
# VAL_DEV_AUTH=true adds a fake "dev login" button so the dashboard is
# testable without google credentials. default off. NEVER enable in production.
VAL_DEV_AUTH=
