# port the api listens on
PORT=10000

# HMAC secret for the API JWTs (HS256). generate: openssl rand -hex 32
API_JWT_SECRET=replace-me-with-a-random-secret

# 64 hex chars (32 bytes) used to AES-256-GCM encrypt stored cookie jars.
# generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-64-hex-chars-00000000000000000000000000000000

# mongodb connection string. when unset, an in-memory repository is used
# (local dev only) and a warning is logged at startup.
MONGODB_URI=

# comma-separated list of allowed CORS origins (http://localhost:3000 is always added)
CORS_ORIGIN=https://yoshik.xyz

# fixture mode: when "true" and the ssid/cookies equal the literal string
# FIXTURE_SSID, canned data is returned instead of hitting Riot (local QA).
VAL_FIXTURE=false
